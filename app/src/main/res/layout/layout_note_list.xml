<?xml version="1.0" encoding="utf-8"?><!--  ~    Hi, Code Enthusiast!  ~    https://github.com/yudiatmoko  --><androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"    xmlns:app="http://schemas.android.com/apk/res-auto"    xmlns:tools="http://schemas.android.com/tools"    android:id="@+id/cl_student_item"    android:layout_width="match_parent"    android:layout_height="wrap_content"    android:backgroundTint="?attr/colorControlNormal">    <TextView        android:id="@+id/tv_title"        android:layout_width="0dp"        android:layout_height="wrap_content"        android:layout_marginHorizontal="12dp"        android:ellipsize="end"        android:fontFamily="@font/nunito_sans_medium"        android:maxLines="1"        android:textSize="18sp"        android:textStyle="bold"        app:layout_constraintBottom_toTopOf="@+id/tv_date"        app:layout_constraintEnd_toStartOf="@+id/btn_edit"        app:layout_constraintStart_toStartOf="parent"        app:layout_constraintTop_toTopOf="parent"        tools:text="TextView" />    <TextView        android:id="@+id/tv_date"        android:layout_width="0dp"        android:layout_height="wrap_content"        android:layout_marginHorizontal="12dp"        android:layout_marginTop="4dp"        android:fontFamily="@font/nunito_sans"        android:textSize="14sp"        android:textStyle="normal"        app:layout_constraintBottom_toTopOf="@+id/view"        app:layout_constraintEnd_toStartOf="@+id/btn_edit"        app:layout_constraintStart_toStartOf="parent"        app:layout_constraintTop_toBottomOf="@+id/tv_title"        tools:text="TextView" />    <View        android:id="@+id/view"        android:layout_width="0dp"        android:layout_height="1dp"        android:layout_marginVertical="10dp"        android:background="@color/Crayola"        app:layout_constraintBottom_toBottomOf="parent"        app:layout_constraintEnd_toEndOf="parent"        app:layout_constraintStart_toStartOf="parent"        app:layout_constraintTop_toBottomOf="@+id/tv_date" />    <ImageButton        android:id="@+id/btn_edit"        android:layout_width="28dp"        android:layout_height="28dp"        android:layout_marginEnd="24dp"        android:background="@android:color/transparent"        android:src="@drawable/rounded_edit_note_24"        app:layout_constraintBottom_toBottomOf="@id/tv_date"        app:layout_constraintEnd_toStartOf="@id/btn_delete"        app:layout_constraintStart_toEndOf="@+id/tv_date"        app:layout_constraintTop_toTopOf="parent" />    <ImageButton        android:id="@+id/btn_delete"        android:layout_width="24dp"        android:layout_height="24dp"        android:layout_marginEnd="12dp"        android:background="@android:color/transparent"        android:src="@drawable/rounded_delete_24"        app:layout_constraintBottom_toBottomOf="@id/tv_date"        app:layout_constraintEnd_toEndOf="parent"        app:layout_constraintStart_toEndOf="@+id/btn_edit"        app:layout_constraintTop_toTopOf="parent" /></androidx.constraintlayout.widget.ConstraintLayout>